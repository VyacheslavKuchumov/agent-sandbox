#!/bin/sh
# Agent sandbox control. Run `bin/sandbox help` for commands.
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"

AGENTS="coder infra admin web"
SERVICES="anthropic github codex-auth.json"

usage() {
  cat <<'EOF'
usage: bin/sandbox <command> [args]

 Setup
  init                       create secrets/ (key placeholder, dashboard secret, broker CA)
  vless                      paste your vless:// key, restart vpn and run tests

 Run
  up [agent...|monitor]      start vpn + broker (+ given agents, e.g. `up coder infra monitor`)
  down                       stop everything
  restart [service...]       restart services (default: vpn keys)
  status                     containers, health, which keys are configured
  logs [vpn|keys|<agent>]    follow logs (vpn = connections, keys = API calls)

 Auth (tokens never enter agent containers)
  login <agent> claude       Claude subscription: one-off `claude setup-token`, token → broker
  login <agent> codex        ChatGPT subscription: one-off `codex login --device-auth`, tokens → broker,
                             the agent gets derived fakes
  key <agent> <service>      store a token for the broker (e.g. `key coder github` = PAT)
  key-rm <agent> <service>   delete a stored token
  keys                       list configured tokens (names only)

 Maintenance
  update [--check] [--min-age N]  bump claude/codex/sing-box/... to stable releases ≥N days old
                                  (default 14), rebuild images, restart running containers
  rebuild                    rebuild all images without changing versions
  apply                      review infra-agent changes (git diff), then rebuild + restart

 Checks
  test                       kill switch + isolation checks
  dashboard                  live connections dashboard (zashboard) URL and secret
  grafana                    history dashboard (Grafana) URL and admin password
EOF
}

die() { echo "sandbox: $*" >&2; exit 1; }
is_agent() { for a in $AGENTS; do [ "$a" = "$1" ] && return 0; done; return 1; }
net_of() { case $1 in coder) echo 1;; infra) echo 2;; admin) echo 3;; assistant) echo 4;; web) echo 5;; esac; }

cmd_init() {
  umask 077
  mkdir -p secrets/keys/ca
  [ -s secrets/grafana_admin_password ] || { head -c 18 /dev/urandom | base64 | tr -d '/+=' > secrets/grafana_admin_password; echo "created secrets/grafana_admin_password"; }
  [ -s secrets/dashboard_secret ] || { head -c 24 /dev/urandom | base64 | tr -d '/+=' > secrets/dashboard_secret; echo "created secrets/dashboard_secret"; }
  [ -s secrets/vless.url ] || { cp secrets/vless.url.example secrets/vless.url; echo "created secrets/vless.url — run: bin/sandbox vless"; }
  if [ ! -s secrets/keys/ca/mitmproxy-ca.pem ]; then
    docker run --rm -u "$(id -u):$(id -g)" -v "$ROOT/secrets/keys/ca:/ca" --entrypoint python3 \
      "$(sed -n 's/^FROM //p' keys/Dockerfile)" \
      -c "from mitmproxy.certs import CertStore; CertStore.from_store('/ca','mitmproxy',2048)"
    echo "created broker CA (secrets/keys/ca)"
  fi
  for a in $AGENTS; do mkdir -p "secrets/keys/$a"; done
  # Host group ids for agent-admin (journal / logs read access).
  sed -i -e "s/^HOST_JOURNAL_GID=.*/HOST_JOURNAL_GID=$(getent group systemd-journal | cut -d: -f3)/" \
         -e "s/^HOST_ADM_GID=.*/HOST_ADM_GID=$(getent group adm | cut -d: -f3)/" .env
  grep -q '^HOST_USER_GID=' .env || echo "HOST_USER_GID=$(id -g)" >> .env
  mkdir -p proposals web-outbox
  chmod 2775 proposals   # agent-admin writes here via your group
  chmod -R go-rwx secrets
}

cmd_rebuild() {
  cmd_init >/dev/null
  cp secrets/keys/ca/mitmproxy-ca-cert.pem agents/base/sbx-ca.crt
  docker compose build vpn keys
  docker build -t agent-sandbox/agent-base:local agents/base
  docker compose --profile admin build admin
}

cmd_apply() {
  [ -d .git ] || die "not a git repository"
  echo "== uncommitted changes:"; git status --short
  echo "== commits not yet applied (since tag 'applied'):"
  git log --oneline applied..HEAD 2>/dev/null || git log --oneline -10
  echo "== diff of security-relevant keys (volumes, privileged, cap_add, network_mode, pid, devices, user):"
  git diff applied -- compose.yaml 2>/dev/null | grep -E '^[+-].*(volumes|source:|privileged|cap_add|network_mode|pid:|devices|user:|docker.sock|internal:|ports:)' || echo "  (none)"
  printf 'full diff? [y/N] '; read -r a; [ "$a" = y ] && git diff applied 2>/dev/null | less
  printf 'apply (rebuild images, recreate running containers)? [y/N] '; read -r a; [ "$a" = y ] || die "aborted"
  was=$(running_services)
  cmd_rebuild
  docker compose --profile "*" up -d --remove-orphans $was
  git tag -f applied >/dev/null && echo "applied; tagged HEAD as 'applied'"
}

running_services() {
  docker compose ps --services --status running 2>/dev/null || true
}

cmd_up() {
  cmd_init >/dev/null
  docker image inspect agent-sandbox/agent-base:local >/dev/null 2>&1 || cmd_rebuild
  docker compose up -d vpn keys
  for a in "$@"; do
    [ "$a" = monitor ] && { docker compose --profile monitor up -d dockerproxy-monitor loki vector grafana; continue; }
    is_agent "$a" || die "unknown agent: $a (available: $AGENTS)"
    [ "$a" = web ] && { echo "web is per-session: use bin/agent web"; continue; }
    docker compose --profile "$a" up -d "$a"
  done
}

cmd_status() {
  docker ps -a --filter name=sbx- --format 'table {{.Names}}\t{{.Status}}'
  echo; cmd_keys
}

cmd_keys() {
  printf '%-10s' "agent"; for s in $SERVICES; do printf '%-12s' "${s%-auth.json}"; done; echo
  for a in $AGENTS; do
    printf '%-10s' "$a"
    for s in $SERVICES; do [ -s "secrets/keys/$a/$s" ] && printf '%-12s' "✓" || printf '%-12s' "-"; done
    echo
  done
}

save_secret() {  # agent service value
  umask 077; mkdir -p "secrets/keys/$1"
  printf '%s\n' "$3" > "secrets/keys/$1/$2"
  docker compose restart keys >/dev/null && echo "saved secrets/keys/$1/$2, broker restarted"
}

cmd_key() {
  [ $# -eq 2 ] || die "usage: key <agent> <service>"
  is_agent "$1" || die "unknown agent: $1"
  printf 'paste token for %s/%s (input hidden): ' "$1" "$2"
  stty -echo; read -r tok; stty echo; echo
  [ -n "$tok" ] || die "empty token"
  save_secret "$1" "$2" "$tok"
}

cmd_login() {
  [ $# -eq 2 ] || die "usage: login <agent> claude"
  is_agent "$1" || die "unknown agent: $1"
  agent=$1; n=$(net_of "$agent")
  case $2 in
    claude)
      echo "Starting a one-off container (no mounts, deleted afterwards) for 'claude setup-token'."
      echo "Open the link in your browser, paste the code back. The token is captured automatically."
      log=$(mktemp -p "${XDG_RUNTIME_DIR:-/tmp}" sbx-login.XXXXXX)
      trap 'shred -u "$log" 2>/dev/null || rm -f "$log"' EXIT INT TERM
      # Straight to the vpn proxy (not the broker): the real token exists only here.
      script -q -e -c "docker run --rm -it --network sbx-$agent \
          -e HTTPS_PROXY=http://10.88.$n.2:7890 -e HTTP_PROXY=http://10.88.$n.2:7890 \
          --entrypoint claude agent-sandbox/agent-base:local setup-token" "$log" || true
      tok=$(tr -d '\r' < "$log" | grep -o 'sk-ant-oat01-[A-Za-z0-9_-]\{20,\}' | tail -1 || true)
      if [ -z "$tok" ]; then
        printf 'token not found in output — paste it manually (hidden): '
        stty -echo; read -r tok; stty echo; echo
      fi
      [ -n "$tok" ] || die "no token"
      save_secret "$agent" anthropic "$tok" ;;
    codex)
      [ "$agent" = web ] && die "web runs claude only"
      case $agent in admin) home=/home/admin; uid=1500 ;; *) home=/home/agent; uid=1000 ;; esac
      tmp=$(mktemp -d -p "${XDG_RUNTIME_DIR:-/tmp}" sbx-codex.XXXXXX)
      trap 'rm -rf "$tmp"' EXIT INT TERM
      echo "Starting a one-off container for 'codex login --device-auth' (only via the vpn)."
      echo "Open the shown URL in your browser and enter the code."
      docker run --rm -it --network "sbx-$agent" -u "$(id -u):$(id -g)" \
        -e HTTPS_PROXY="http://10.88.$n.2:7890" -e HTTP_PROXY="http://10.88.$n.2:7890" \
        -e CODEX_HOME=/codexhome -v "$tmp:/codexhome" \
        --entrypoint codex agent-sandbox/agent-base:local login --device-auth
      [ -s "$tmp/auth.json" ] || die "login did not produce auth.json"
      umask 077; mkdir -p "secrets/keys/$agent"
      cp "$tmp/auth.json" "secrets/keys/$agent/codex-auth.json"
      # The agent gets derived fakes only; the broker maps them back to the real tokens.
      python3 -I keys/codexauth.py fake < "$tmp/auth.json" | \
        docker run --rm -i -u "$uid:$uid" -v "agent-sandbox_${agent}_home:$home" --entrypoint sh \
          agent-sandbox/agent-base:local -c "mkdir -p $home/.codex && cat > $home/.codex/auth.json && chmod 600 $home/.codex/auth.json
            [ -f $home/.codex/config.toml ] || echo 'cli_auth_credentials_store = \"file\"' > $home/.codex/config.toml"
      docker compose restart keys >/dev/null
      echo "codex login saved for $agent (real tokens: secrets/keys/$agent/codex-auth.json, broker restarted)" ;;
    *) die "unknown tool: $2" ;;
  esac
}

cmd_update() {
  mode=bump; age=14
  while [ $# -gt 0 ]; do
    case $1 in --check) mode=check;; --min-age) age=$2; shift;; *) die "unknown option $1";; esac; shift
  done
  python3 -I bin/versions.py "$mode" --min-age "$age"
  [ "$mode" = bump ] || return 0
  was=$(running_services)
  cmd_rebuild
  [ -n "$was" ] && docker compose --profile "*" up -d $was
  echo "update done. running: $(running_services | tr '\n' ' ')"
}

cmd_vless() {
  printf 'paste your vless:// key (input hidden): '
  stty -echo; read -r url; stty echo; echo
  case $url in vless://*) ;; *) die "expected a vless:// URL";; esac
  umask 077; printf '%s\n' "$url" > secrets/vless.url
  docker compose up -d --force-recreate vpn
  echo "waiting for tunnel..."; sleep 6
  docker logs sbx-vpn 2>&1 | grep -E "gen-config|entrypoint|ERROR" | tail -5
  tests/killswitch.sh
}

case "${1:-help}" in
  init)      cmd_init ;;
  vless)     cmd_vless ;;
  up)        shift; cmd_up "$@" ;;
  down)      docker compose --profile "*" down ;;
  restart)   shift; docker compose restart ${*:-vpn keys} ;;
  status)    cmd_status ;;
  logs)      case ${2:-vpn} in vpn) docker logs -f --tail 50 sbx-vpn;; keys) docker logs -f --tail 50 sbx-keys;;
               *) docker logs -f --tail 50 "sbx-agent-$2";; esac ;;
  login)     shift; cmd_login "$@" ;;
  key)       shift; cmd_key "$@" ;;
  key-rm)    shift; [ $# -eq 2 ] || die "usage: key-rm <agent> <service>"; rm -f "secrets/keys/$1/$2"; docker compose restart keys >/dev/null; echo "removed" ;;
  keys)      cmd_keys ;;
  update)    shift; cmd_update "$@" ;;
  rebuild)   cmd_rebuild ;;
  apply)     cmd_apply ;;
  test)      exec tests/killswitch.sh ;;
  dashboard) echo "URL:    http://127.0.0.1:9090/ui/  (backend: http://127.0.0.1:9090)"
             echo "Secret: $(cat secrets/dashboard_secret)" ;;
  grafana)   echo "URL:      http://127.0.0.1:3300/  (dashboard «Запросы»)"
             echo "Login:    admin / $(cat secrets/grafana_admin_password)" ;;
  help|-h|--help) usage ;;
  *)         usage; exit 1 ;;
esac
