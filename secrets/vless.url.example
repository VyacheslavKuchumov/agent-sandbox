# Вставь сюда свою ссылку одной строкой (файл: secrets/vless.url, chmod 600).
# Примеры форматов:
# vless://UUID@example.com:443?type=tcp&security=reality&pbk=PUBKEY&sid=abcd&sni=www.microsoft.com&fp=chrome&flow=xtls-rprx-vision#name
# vless://UUID@example.com:443?type=ws&security=tls&path=%2Fws&host=example.com&sni=example.com#name
# vless://UUID@example.com:443?type=grpc&security=tls&serviceName=grpc&sni=example.com#name
