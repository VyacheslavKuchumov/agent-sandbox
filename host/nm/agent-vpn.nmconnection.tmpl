# NetworkManager profile: whole host through the agent-sandbox VPN (WireGuard → sing-box → VLESS).
# Generated by `bin/sandbox host-vpn install`. Routing rules keep Docker / LAN / the
# vpn container's own VLESS connection out of the tunnel (otherwise it would loop).
[connection]
id=agent-vpn
uuid=@UUID@
type=wireguard
interface-name=sbx-wg
autoconnect=false

[wireguard]
private-key=@CLIENT_PRIVATE@

[wireguard-peer.@SERVER_PUBLIC@]
endpoint=10.88.0.2:51820
allowed-ips=0.0.0.0/0;
persistent-keepalive=25

[ipv4]
method=manual
address1=10.99.0.2/32
dns=10.99.0.1;
dns-priority=-50
dns-search=~;
routing-rule1=priority 100 from 10.88.0.0/16 table 254
routing-rule2=priority 101 to 10.88.0.0/16 table 254
routing-rule3=priority 102 from 172.16.0.0/12 table 254
routing-rule4=priority 103 to 172.16.0.0/12 table 254
routing-rule5=priority 104 to 192.168.0.0/16 table 254

[ipv6]
method=disabled
