{
  "uid": "sbx-requests",
  "title": "Запросы",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "agent",
        "type": "custom",
        "query": "coder,infra,admin,web,assistant,keys,host",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*"
      },
      {
        "name": "domain",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Запросы агентов по времени (sing-box)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (agent) (count_over_time({source=\"vpn\", event=\"connection\"}[$__interval]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "title": "Куда ходят агенты: топ доменов за период",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(50, sum by (agent, dest_host) (count_over_time({source=\"vpn\", event=\"connection\"} | json | agent=~\"$agent\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Брокер: API-вызовы с подстановкой токенов",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{source=\"keys\", event=\"api_call\"} | json | agent=~\"$agent\" | line_format \"{{.agent}}  {{.service}}  {{.method}} {{.host}}{{.path}} → {{.status}}  injected={{.injected}}\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "title": "Хост: программы и соединения (OpenSnitch)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{source=\"host\", app=~\"opensnitch.*\"}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "title": "Хост: режим VPN / direct (sandbox-host-watch)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{source=\"host\", app=\"sbx-host-watch\"}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 6,
      "title": "Почтовый шлюз: действия assistant",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{source=\"mailgw\"} | json | line_format \"{{.event}} {{.tool}} {{.summary}}\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 7,
      "title": "Поиск по домену во всех источниках ($domain)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{source=~\".+\"} |= \"$domain\"",
          "queryType": "range"
        }
      ]
    }
  ]
}